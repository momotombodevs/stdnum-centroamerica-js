{
  "name": "@momotombo/stdnum-centroamerica",
  "version": "0.1.0",
  "description": "Validación de documentos de identidad y fiscales de Centroamérica",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "publint && attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momotombodevs/stdnum-centroamerica-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/momotombodevs/stdnum-centroamerica-js#readme",
  "bugs": {
    "url": "https://github.com/momotombodevs/stdnum-centroamerica-js/issues"
  },
  "keywords": [
    "stdnum",
    "centroamerica",
    "nit",
    "dui",
    "dpi",
    "cedula",
    "ruc",
    "nicaragua",
    "guatemala",
    "honduras",
    "el-salvador",
    "costa-rica",
    "panama",
    "mrz",
    "icao",
    "validation",
    "typescript",
    "react",
    "vue",
    "angular",
    "nestjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "momotombo"
}
